{
  "name": "tests",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test:api:health:local": "cross-env TEST_ENV=local playwright test api-automation/health --project=api",
    "test:api:health:dev": "cross-env TEST_ENV=dev playwright test api-automation/health --project=api",
    "test:api:health:prod": "cross-env TEST_ENV=prod playwright test api-automation/health --project=api",
    "test:api:dev": "cross-env TEST_ENV=dev playwright test --project=api",
    "test:api:smoke:dev": "cross-env TEST_ENV=dev playwright test --project=api --grep @smoke",
    "test:api:regression:dev": "cross-env TEST_ENV=dev playwright test --project=api --grep @regression",
    "test:api:prod": "cross-env TEST_ENV=prod playwright test --project=api --grep @smoke --grep-invert \"@dev-only|@data-creation\""
  },
